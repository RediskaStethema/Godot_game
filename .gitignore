# Godot 4+ specific ignores
.godot/
/android/
*.tmp
*.translation


/build/
/export/
*.exe
*.pck
*.apk
*.aab
*.zip

# Сторонние аддоны (не подключены к проекту)
/godot_agent-*/
/open_godot_mcp/

# Временные тест-скрипты агентов в корне (постоянные тесты — в tests/)
/_tmp_*.gd
/_tmp_*.gd.uid

# История чатов godot_agent, если аддон когда-нибудь поставят в addons/
/addons/godot_agent/conversations/

# Работа с ИИ: дизайн-документ, промпты и инструкции Claude Code, субагенты,
# справочники и брифы для агентов — только локально, не в репозиторий
/WH40K_TDD.docx
/CLAUDE.md
/ASSETS_NEEDED.txt
/CARD_ART_NEEDED.txt
/EFFECTS_NEEDED.txt
/UI_NEEDED.txt
/ART_TZ_*.txt
/CLAUDE_CODE_PROMPT.md
/.claude/
/skills/
/.agents/
/skills-lock.json
/docs/task-briefs/
/docs/TDD.md

# Мусор ОС и редакторов
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Кэш Python инструментов tools/
__pycache__/

# Исходники арта: из них tools/ режут ассеты игры, сама игра их не грузит
/assets/source_sheets/
/assets/ui/assets/
/assets/FightFleed/
/assets/chaos_assets/
/assets/citadel_sprite_list/
/assets/citadel_marine.png*
/assets/Готический набор руин*
/assets/effects/FXpack13/Effect*/
/assets/effects/Pixel/PNG_1x/
/assets/effects/Pixel/PNG_2x/
/buildings_png/
/Screenshot*
/assets_menu.png*

# Справка Claude по картам и способностям (локальная)
/CARD_ABILITIES.txt

# Исходный звуковой пакет (09.11.2026): в игру — копии по событиям в assets/audio
/assets/sounds_for_gWHKINGS/

# Копия всего визуала для переработки (tools/collect_visuals.py) — не в репозиторий
visual_export/

# Снимки и образцы пользователя (решения ссылаются на них по имени) — локально
/docs/screenshots/*
!/docs/screenshots/.gdignore
!/docs/screenshots/image.webp

