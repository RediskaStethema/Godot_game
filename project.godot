; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WH40KINGS"
run/main_scene="res://scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BattleManager="*uid://chev5upa30uny"
EconomyManager="*uid://duwdew3wsafh"
ShopManager="*uid://yojx10edd6be"
SoldierRegistry="*uid://8t36wymn2u4x"
SquadRegistry="*uid://dm35nd2j3qgfu"
SynergyManager="*res://scripts/autoload/SynergyManager.gd"
RunManager="*res://scripts/autoload/RunManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
GameSettings="*res://scripts/autoload/GameSettings.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
MetaProgress="*res://scripts/autoload/MetaProgress.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
